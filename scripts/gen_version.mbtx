///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/env",
  "moonbitlang/moon_config@0.4.2",
  "moonbitlang/x@0.5.5/sys",
}

///|
suberror VersionError {
  InvalidConfig(String)
} derive(Debug)

///|
async fn generate_version(output : String) -> Unit {
  let source = @fs.read_file("moon.mod").text()
  let (ast, reports) = @moon_config.parse_moon_mod(source)
  if !reports.is_empty() {
    raise InvalidConfig(
      "invalid moon.mod:\n" + reports.map(r => Show::to_string(r)).join("\n"),
    )
  }
  let version = match ToJson::to_json(ast) {
    { "version": String(version), .. } if !version.is_empty() => version
    _ => raise InvalidConfig("moon.mod requires a nonempty string version")
  }
  @fs.write_file(
    output,
    "const MODULE_VERSION = \{Repr(version)}\n",
    create_mode=CreateOrTruncate,
  )
}

///|
/// Run from the module root:
/// moon run scripts/gen_version.mbtx -- -o version.mbt
async fn main {
  guard @env.args() is [_, "-o", output] && !output.is_empty() else {
    eprintln("usage: moon run scripts/gen_version.mbtx -- -o <output-file>")
    @sys.exit(2)
    return
  }
  generate_version(output) catch {
    InvalidConfig(message) => {
      eprintln("error: " + message)
      @sys.exit(1)
    }
    error => {
      eprintln("error: \{error}")
      @sys.exit(1)
    }
  }
}
