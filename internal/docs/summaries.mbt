let _embed_summaries_md : String =
  #|# Counters, summaries, and process exit status
  #|
  #|## Read mooncram's exit status first
  #|
  #|These statuses belong to mooncram, independently of tested programs' expected
  #|exit statuses. A program returning `2` can pass a case ending in `[2]`, so
  #|`mooncram test` returns `0` when all cases pass.
  #|
  #|| Exit status | Condition |
  #|| --- | --- |
  #|| `0` | Help/version or `docs` succeeded; `check` validated at least one case with no errors; `test` ran at least one case with no errors or mismatches; or `update`/dry-run finished without errors, regardless of mismatches. |
  #|| `1` | `test` has at least one mismatch and no errors. |
  #|| `2` | Argument/discovery failure, any recorded document or case error, or no cases found. |
  #|
  #|**Use `test` for CI.** `update --dry-run` can print `FAIL`, propose changes and
  #|exit with `0`. Successful previewing or updating does not mean assertions passed.
  #|Errors take precedence over mismatches.
  #|
  #|## Summary lines and counters
  #|
  #|After processing all discovered files, normal summaries go to stdout:
  #|
  #|```text
  #|<total> cases, <errors> errors
  #|<total> cases, <failed> failed, <errors> errors
  #|<total> cases, updated <updated>, <errors> errors
  #|<total> cases, would update <updated>, <errors> errors
  #|```
  #|
  #|These formats correspond to `check`, `test`, `update`, and `update --dry-run`,
  #|respectively. For example:
  #|
  #|```text
  #|3 cases, 0 errors
  #|3 cases, 1 failed, 0 errors
  #|3 cases, updated 1, 0 errors
  #|3 cases, would update 1, 0 errors
  #|```
  #|
  #|| Counter | Meaning |
  #|| --- | --- |
  #|| `total` | Cases whose checking or execution was attempted, incremented before processing each case. Includes cases with target-resolution or execution errors; excludes configuration directives and cases in documents that failed parsing or module/directory declaration validation. |
  #|| `failed` | Completed cases whose output and/or exit status mismatched. Execution errors are counted separately. Printed only for `test`. |
  #|| `errors` | Caught per-case target-resolution or execution errors plus document read/parse/declaration-validation/update errors. A parse or declaration-validation failure counts as one document error. |
  #|| `updated` | Changed cases in documents successfully written, or eligible for a dry-run document diff, including normalization and every case sharing changed fence markers. Each case counts once, not once per changed line. |
  #|
  #|Documents whose updates are suppressed or whose write fails do not contribute
  #|to `updated`. An update can print `FAIL` reports and still have `updated 0`
  #|because a later execution error suppressed that document's changes.
  #|
  #|A document error with zero attempted cases still produces a summary such as
  #|`0 cases, 1 errors` for `check` or `0 cases, 0 failed, 1 errors` for `test`;
  #|the special no-cases message applies
  #|only when both total and errors are zero.
  #|Argument/discovery failures, help/version, `docs`, and that no-cases path have no normal
  #|summary.
  #|

///|
pub let summaries_md : String = _embed_summaries_md
