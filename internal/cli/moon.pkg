import {
  "moonbit-community/mooncram/internal/diagnostic",
  "moonbit-community/mooncram/internal/execute",
  "moonbit-community/mooncram/internal/files",
  "moonbit-community/mooncram/internal/markdown",
  "moonbit-community/mooncram/internal/output",
  "moonbit-community/mooncram/internal/report",
  "moonbit-community/mooncram/internal/resolve",
  "moonbit-community/mooncram/internal/update",
  "moonbitlang/async/fs",
  "moonbitlang/async/stdio",
  "moonbitlang/core/argparse",
  "moonbitlang/core/string",
  "moonbitlang/x/path",
}

rule(
  name: "gen_version",
  command: "moonx ./scripts/gen_version.mbtx -o $output",
)

dev_build(rule: "gen_version", input: "../../moon.mod", output: "version.mbt")

supported_targets = "wasm+native"
